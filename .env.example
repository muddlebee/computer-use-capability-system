# Selects the OpenAI-compatible API endpoint: "openrouter" or "openai".
LLM_PROVIDER=openrouter

# OpenRouter configuration.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=Computer Use Capability System

# Direct OpenAI configuration. Used when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional override for another OpenAI-compatible endpoint.
# LLM_BASE_URL=
