<%- include("partials/header", { title: "Account Details" }) %>
<table class="details-table">
  <tr><th>Account</th><td>Checking ****<%= member.accountLast4 %></td></tr>
  <tr><th>Available balance</th><td><%= member.balance %></td></tr>
</table>
<h2>Account actions</h2>
<% if (permissionDenied) { %>
  <div class="alert error" role="alert">Permission denied: fee reversals are unavailable for your operator role.</div>
<% } else { %>
  <ul class="action-list">
    <li><a href="<%= reversalUrl %>">Prepare fee reversal</a></li>
  </ul>
<% } %>
<%- include("partials/footer") %>
