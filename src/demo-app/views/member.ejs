<%- include("partials/header", { title: "Member Details" }) %>
<table class="details-table">
  <tr><th>Member number</th><td data-sensitive="true"><%= member.id %></td></tr>
  <tr><th>Member name</th><td data-sensitive="true"><%= member.name %></td></tr>
</table>
<h2>Accounts</h2>
<table class="grid">
  <tr><th>Type</th><th>Account</th><th>Available balance</th><th>Action</th></tr>
  <tr>
    <td>Checking</td>
    <td data-sensitive="true">****<%= member.accountLast4 %></td>
    <td data-sensitive="true"><%= member.balance %></td>
    <td><a href="<%= accountUrl %>">Open account</a></td>
  </tr>
</table>
<%- include("partials/footer") %>
