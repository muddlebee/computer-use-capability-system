{
  "schemaVersion": "1.0.0",
  "capability": {
    "id": "prepare-fee-reversal",
    "version": "0.1.0",
    "summary": "The Fee Reversal Review page is visible, all declared outputs have been extracted, and no reversal was submitted."
  },
  "target": {
    "appId": "legacy-credit-union",
    "surface": "browser",
    "entryUrl": "http://127.0.0.1:3000/servicing/search?scenario=happy",
    "allowedOrigins": [
      "http://127.0.0.1:3000"
    ],
    "allowedPathPatterns": [
      "^/servicing/"
    ]
  },
  "inputs": [
    {
      "name": "memberId",
      "type": "string",
      "sensitive": true,
      "pattern": "^M-[0-9]{4}$"
    },
    {
      "name": "amount",
      "type": "decimal",
      "sensitive": false
    },
    {
      "name": "reason",
      "type": "enum",
      "sensitive": false,
      "values": [
        "duplicate_fee",
        "incorrect_fee",
        "other"
      ]
    }
  ],
  "outputs": [
    {
      "name": "reviewReference",
      "type": "string",
      "description": "Reference displayed on the review screen",
      "sensitive": true,
      "parser": "text"
    },
    {
      "name": "accountLast4",
      "type": "string",
      "description": "Last four characters of the account number",
      "sensitive": true,
      "parser": "last4"
    },
    {
      "name": "amount",
      "type": "currency",
      "description": "Fee reversal amount shown for review",
      "sensitive": false,
      "parser": "currency"
    },
    {
      "name": "reviewStatus",
      "type": "string",
      "description": "Current review status",
      "sensitive": false,
      "parser": "text"
    }
  ],
  "steps": [
    {
      "id": "step-1",
      "kind": "type",
      "target": {
        "key": "memberidField",
        "strategies": [
          {
            "kind": "role",
            "role": "textbox",
            "name": "Member number",
            "exact": true
          },
          {
            "kind": "attribute",
            "name": "name",
            "value": "memberId"
          },
          {
            "kind": "css",
            "selector": "input[name=\"memberId\"]"
          }
        ]
      },
      "value": {
        "kind": "input",
        "inputRef": "memberId"
      },
      "timeoutMs": 5000
    },
    {
      "id": "step-2",
      "kind": "click",
      "target": {
        "key": "searchMembersButton",
        "strategies": [
          {
            "kind": "role",
            "role": "button",
            "name": "Search Members",
            "exact": true
          },
          {
            "kind": "text",
            "text": "Search Members",
            "exact": true
          },
          {
            "kind": "css",
            "selector": "body:nth-of-type(1) > main:nth-of-type(1) > form:nth-of-type(1) > button:nth-of-type(1)"
          }
        ]
      },
      "timeoutMs": 5000
    },
    {
      "id": "step-3",
      "kind": "click",
      "target": {
        "key": "openAccountLink",
        "strategies": [
          {
            "kind": "role",
            "role": "link",
            "name": "Open account",
            "exact": true
          },
          {
            "kind": "text",
            "text": "Open account",
            "exact": true
          },
          {
            "kind": "css",
            "selector": "body:nth-of-type(1) > main:nth-of-type(1) > table:nth-of-type(2) > tbody:nth-of-type(1) > tr:nth-of-type(2) > td:nth-of-type(4) > a:nth-of-type(1)"
          }
        ]
      },
      "timeoutMs": 5000
    },
    {
      "id": "step-4",
      "kind": "click",
      "target": {
        "key": "prepareFeeReversalLink",
        "strategies": [
          {
            "kind": "role",
            "role": "link",
            "name": "Prepare fee reversal",
            "exact": true
          },
          {
            "kind": "text",
            "text": "Prepare fee reversal",
            "exact": true
          },
          {
            "kind": "css",
            "selector": "body:nth-of-type(1) > main:nth-of-type(1) > ul:nth-of-type(1) > li:nth-of-type(1) > a:nth-of-type(1)"
          }
        ]
      },
      "timeoutMs": 5000
    },
    {
      "id": "step-5",
      "kind": "type",
      "target": {
        "key": "amountField",
        "strategies": [
          {
            "kind": "role",
            "role": "textbox",
            "name": "Reversal amount",
            "exact": true
          },
          {
            "kind": "attribute",
            "name": "name",
            "value": "amount"
          },
          {
            "kind": "css",
            "selector": "input[name=\"amount\"]"
          }
        ]
      },
      "value": {
        "kind": "input",
        "inputRef": "amount"
      },
      "timeoutMs": 5000
    },
    {
      "id": "step-6",
      "kind": "select",
      "target": {
        "key": "reasonField",
        "strategies": [
          {
            "kind": "role",
            "role": "combobox",
            "name": "-- Select reason -- Duplicate fee Incorrect fee Other",
            "exact": true
          },
          {
            "kind": "attribute",
            "name": "name",
            "value": "reason"
          },
          {
            "kind": "css",
            "selector": "select[name=\"reason\"]"
          }
        ]
      },
      "value": {
        "kind": "input",
        "inputRef": "reason"
      },
      "timeoutMs": 5000
    },
    {
      "id": "step-7",
      "kind": "click",
      "target": {
        "key": "continueToReviewButton",
        "strategies": [
          {
            "kind": "role",
            "role": "button",
            "name": "Continue to review",
            "exact": true
          },
          {
            "kind": "text",
            "text": "Continue to review",
            "exact": true
          },
          {
            "kind": "css",
            "selector": "body:nth-of-type(1) > main:nth-of-type(1) > form:nth-of-type(1) > button:nth-of-type(1)"
          }
        ]
      },
      "timeoutMs": 5000
    },
    {
      "id": "step-8",
      "kind": "extract",
      "target": {
        "key": "reviewReferenceTarget",
        "strategies": [
          {
            "kind": "row_label",
            "label": "Review reference"
          },
          {
            "kind": "css",
            "selector": "body:nth-of-type(1) > main:nth-of-type(1) > table:nth-of-type(1) > tbody:nth-of-type(1) > tr:nth-of-type(1) > td:nth-of-type(1)"
          }
        ]
      },
      "outputName": "reviewReference",
      "parser": "text",
      "timeoutMs": 5000
    },
    {
      "id": "step-9",
      "kind": "extract",
      "target": {
        "key": "accountTarget",
        "strategies": [
          {
            "kind": "row_label",
            "label": "Account"
          },
          {
            "kind": "css",
            "selector": "body:nth-of-type(1) > main:nth-of-type(1) > table:nth-of-type(1) > tbody:nth-of-type(1) > tr:nth-of-type(2) > td:nth-of-type(1)"
          }
        ]
      },
      "outputName": "accountLast4",
      "parser": "last4",
      "timeoutMs": 5000
    },
    {
      "id": "step-10",
      "kind": "extract",
      "target": {
        "key": "amountTarget",
        "strategies": [
          {
            "kind": "row_label",
            "label": "Amount"
          },
          {
            "kind": "css",
            "selector": "body:nth-of-type(1) > main:nth-of-type(1) > table:nth-of-type(1) > tbody:nth-of-type(1) > tr:nth-of-type(3) > td:nth-of-type(1)"
          }
        ]
      },
      "outputName": "amount",
      "parser": "currency",
      "timeoutMs": 5000
    },
    {
      "id": "step-11",
      "kind": "extract",
      "target": {
        "key": "statusTarget",
        "strategies": [
          {
            "kind": "row_label",
            "label": "Status"
          },
          {
            "kind": "css",
            "selector": "body:nth-of-type(1) > main:nth-of-type(1) > table:nth-of-type(1) > tbody:nth-of-type(1) > tr:nth-of-type(5) > td:nth-of-type(1)"
          }
        ]
      },
      "outputName": "reviewStatus",
      "parser": "text",
      "timeoutMs": 5000
    }
  ],
  "checkpoint": {
    "kind": "text_present",
    "text": "Fee Reversal Review"
  },
  "businessOutcomes": [
    {
      "code": "member_not_found",
      "condition": {
        "kind": "text_present",
        "text": "No member found for that identifier"
      }
    }
  ],
  "runtime": {
    "recoveries": [
      {
        "code": "session_extended",
        "condition": {
          "kind": "text_present",
          "text": "Your session is about to expire"
        },
        "action": {
          "kind": "click",
          "target": {
            "key": "continueSessionControl",
            "strategies": [
              {
                "kind": "role",
                "role": "button",
                "name": "Continue session",
                "exact": true
              },
              {
                "kind": "role",
                "role": "link",
                "name": "Continue session",
                "exact": true
              },
              {
                "kind": "text",
                "text": "Continue session",
                "exact": true
              }
            ]
          }
        },
        "maxAttempts": 1
      }
    ],
    "hardFailures": [
      {
        "code": "permission_denied",
        "condition": {
          "kind": "text_present",
          "text": "Permission denied"
        }
      }
    ],
    "interventions": [
      {
        "reason": "supervisor_authorization",
        "condition": {
          "kind": "text_present",
          "text": "Supervisor authorization required"
        },
        "humanAction": {
          "kind": "click",
          "target": {
            "key": "approveAsSupervisorControl",
            "strategies": [
              {
                "kind": "role",
                "role": "button",
                "name": "Approve as supervisor",
                "exact": true
              },
              {
                "kind": "role",
                "role": "link",
                "name": "Approve as supervisor",
                "exact": true
              },
              {
                "kind": "text",
                "text": "Approve as supervisor",
                "exact": true
              }
            ]
          }
        }
      }
    ]
  },
  "policy": {
    "allowedActions": [
      "click",
      "type",
      "select",
      "extract",
      "wait_for"
    ],
    "irreversibleActions": "deny"
  }
}
